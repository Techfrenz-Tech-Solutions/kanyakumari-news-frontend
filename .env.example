# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real URLs or secrets.

# ------------------------------------------------------------
# LOCAL DEV ONLY
# Vite proxies /api and /uploads to this target during `npm run dev`.
# The browser never sees this URL — it only ever calls /api on localhost.
# Example: VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3001
# ------------------------------------------------------------
VITE_DEV_API_PROXY_TARGET=

# ------------------------------------------------------------
# SITEMAP GENERATOR (scripts/generate-sitemap.mjs)
# Set this to your backend URL so the script can fetch live
# articles when building sitemaps. Used server-side only,
# never bundled into client code.
# Example: SITEMAP_API_BASE_URL=http://127.0.0.1:3001
# ------------------------------------------------------------
SITEMAP_API_BASE_URL=

# ------------------------------------------------------------
# NOTE: In production (Netlify), set API_PROXY_TARGET in the
# Netlify dashboard → Site settings → Environment variables.
# This is the real backend URL used by the _redirects proxy rule.
# It is never exposed to the browser.
# ------------------------------------------------------------
